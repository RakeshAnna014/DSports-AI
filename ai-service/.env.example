# Copy to .env for local development. Never commit real values.
JWT_SECRET=<same value as the DSports backend JWT_SECRET, at least 32 bytes>
AI_CUSTOMER_HASH_KEY=<random value, at least 16 bytes; different from JWT_SECRET>
DSPORTS_BASE_URL=http://localhost:8080
AI_DATABASE_URL=postgresql://<user>:<password>@localhost:5432/dsports_ai
GOOGLE_APPLICATION_CREDENTIALS=<path to a service-account key file>
GOOGLE_CLOUD_PROJECT=
AI_VERTEX_LOCATION=us-central1
AI_INTENT_MODEL=gemini-2.5-flash-lite
AI_REASONING_MODEL=gemini-2.5-flash
AI_EMBEDDING_MODEL=text-embedding-005
AI_EMBEDDING_DIM=768
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.2
AI_TOP_K=5
AI_MAX_TOOL_CALLS=8
AI_TIMEOUT_S=30
# Optional, USD per 1M tokens, set from your own price sheet; empty means cost is not estimated.
AI_PRICE_TABLE_JSON={}

# --- Product & Supplier Intelligence (Phase 5). Nothing here is a default business fact: no exchange rate, supplier, price or research source is built in.
# External research sources (permitted public catalogues / product feeds only). Empty = research uses customer searches and buyer entries and reports the external source as unavailable.
# Format per feed: name, url, format ("json" list of products, or "jsonld" schema.org Product), optional sport, optional supplier {name,type,website,country} to record public listings.
SOURCING_FEEDS=
# Comma separated host allow-list (SSRF protection): a feed host must be listed here. Redirects are followed by hand and every hop is re-checked against the allow-list; private/loopback addresses are refused and the connection is pinned to the validated address.
SOURCING_ALLOWED_HOSTS=
# Typed research providers (JSON list). Only the manufacturer's own site is implemented: it needs its host AND its image CDN in SOURCING_ALLOWED_HOSTS. robots.txt is honoured. Example:
# SOURCING_PROVIDERS=[{"type":"victor_sport","max_products":12,"supplier_countries":["India"]}]
# SOURCING_ALLOWED_HOSTS=www.victorsport.com,dkjulgymkya8y.cloudfront.net
SOURCING_PROVIDERS=
# Hosts a buyer may add product images from, and that image validation may contact (subset of the allow-list).
SOURCING_IMAGE_HOSTS=
SOURCING_TIMEOUT_S=10
SOURCING_MAX_BYTES=1000000
SOURCING_BASE_CURRENCY=INR
# Operator-supplied exchange rates WITH source and date. A rate without both is ignored (no conversion is guessed). Example:
# SOURCING_FX_RATES={"USD":{"rate":83.1,"source":"treasury rate sheet","as_of":"2026-10-14"}}
SOURCING_FX_RATES=
# Optional JSON overrides of the default score weights, e.g. {"margin":0.3,"unmet_demand":0.2}
SOURCING_SCORE_WEIGHTS=
# Optional: used by the MOQ-exposure dimension of the score (in the base currency)
SOURCING_WORKING_CAPITAL_LIMIT=
SOURCING_LOOKBACK_DAYS=30
SOURCING_DEMAND_MIN_CUSTOMERS=2
SOURCING_QUOTE_STALE_DAYS=90
SOURCING_RUNS_PER_HOUR=6
# Allows the clearly labelled DEMO data seed endpoint (disable in any shared environment)
SOURCING_ENABLE_DEMO=true
# Sales & Inventory Planning (Phase 6): see docs/ai/phase6/README.md. All optional; these are the defaults.
# PLANNING_TIMEZONE=Asia/Kolkata
# PLANNING_WEEK_START=0
# PLANNING_FY_START_MONTH=4
# PLANNING_HORIZON_WEEKS=13
# PLANNING_LOOKBACK_WEEKS=104
# PLANNING_MIN_HISTORY_WEEKS=26
# PLANNING_BACKTEST_ORIGINS=6
# PLANNING_BACKTEST_STEP_WEEKS=4
# PLANNING_MIN_EVAL_OBSERVATIONS=30
# PLANNING_MIN_EVAL_UNITS=100
# PLANNING_STATE_REGION_MAP=
# PLANNING_VARIANCE_PCT=20
# PLANNING_VARIANCE_MIN_UNITS=10
# PLANNING_TRANSFER_LEAD_DAYS=3
# PLANNING_TRANSFER_CROSS_REGION_DAYS=6
# PLANNING_TRANSFER_MIN_QTY=2
# PLANNING_TRANSFER_UNIT_COST=
# PLANNING_ALLOW_SELF_APPROVAL=false
# PLANNING_ENABLE_DEMO=true

# Access-token claims (must match the Java backend's JWT_ISSUER / JWT_AUDIENCE; both default to the values below)
# JWT_ISSUER=dsports
# JWT_AUDIENCE=dsports-api

# Prometheus scraping outside local development: an administrator token, or this static scrape token (use a long random value)
# AI_METRICS_TOKEN=

# Environment name: anything other than local/test/dev protects /metrics, and prod/production also disables /docs and /openapi.json
# AI_ENV=prod
# PLANNING_ANALYSES_PER_MIN=6
